# Backend (Express) base URL. Read at build time: the browser calls /api, /images and /socket.io
# on this site, and Next.js proxies them here (see next.config.ts). Rebuild after changing it.
API_URL=https://api.transniaga.manokwarikab.go.id

# This site's public address: product links in WhatsApp messages ("Halo kak ... <link>"). Read at build time.
SITE_URL=https://transniaga.manokwarikab.go.id

# Contact shown in Panduan → "Hubungi Administrator" (optional; leave empty to hide)
NEXT_PUBLIC_ADMIN_WHATSAPP=
NEXT_PUBLIC_ADMIN_EMAIL=

# Shared with the backend (same REVALIDATE_SECRET in its .env): lets it refresh the cached landing pages right
# after a change (POST /internal/revalidate). Read at runtime. Empty = off (pages refresh within 60 s).
REVALIDATE_SECRET=
